# Copy to backend/.env (ignored by git). Dummy values only.

# Application URL: Neon's pooler in production. statement_cache_size=0 is set by the code.
DATABASE_URL=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus
# Direct URL, for Alembic only.
DATABASE_URL_DIRECT=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus
# Integration tests: local `nexus_test` database, or the service container in CI.
TEST_DATABASE_URL=postgresql+asyncpg://nexus:nexus@127.0.0.1:5432/nexus_test

# Front-end origins allowed to call the API (JSON list).
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Model gateway.
GEMINI_API_KEY=dummy-gemini-key

# Tracing; optional locally.
LANGFUSE_PUBLIC_KEY=pk-lf-dummy
LANGFUSE_SECRET_KEY=sk-lf-dummy
LANGFUSE_HOST=https://cloud.langfuse.com
